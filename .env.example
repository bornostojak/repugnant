# Listen on all interfaces for a trusted LAN/VPN deployment.
RPG_HTTP_ADDR=0.0.0.0:8080

# SQLite is the default and stores data in the named Docker volume.
RPG_DB_DRIVER=sqlite
RPG_DB_DSN=file:/app/data/rpg.db?_pragma=busy_timeout(5000)

# PostgreSQL alternative (set both values; provision PostgreSQL separately).
# RPG_DB_DRIVER=postgres
# RPG_DB_DSN=postgres://rpg:change-me@postgres:5432/rpg?sslmode=disable
